{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Data Studio API",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "data-studio-api",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Uvicorn running on http://127\\.0\\.0\\.1:8000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Start Data Studio Frontend",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "data-studio-frontend",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Run App",
      "dependsOn": ["Start Data Studio API", "Start Data Studio Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
